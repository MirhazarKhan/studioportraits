# =================================================================
# AI Portrait Generator - Environment Configuration Template
# Copy this file to .env and configure your desired settings.
# =================================================================

# Backend Generation Provider: "export", "gemini", "openai", or "stability"
PORTRAIT_PROVIDER=export

# Google Cloud / Gemini API Key (Optional: for direct Imagen 3 synthesis)
GEMINI_API_KEY=

# OpenAI API Key (Optional: for direct DALL-E 3 synthesis)
OPENAI_API_KEY=

# Stability AI API Key (Optional: for direct SDXL / Stable Diffusion synthesis)
STABILITY_API_KEY=

# Default Resolution and Quality
DEFAULT_WIDTH=1024
DEFAULT_HEIGHT=1024
JPEG_QUALITY=95
